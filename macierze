#include<iostream>
#include<iomanip>
using namespace std;

int main() {
	int matrix[3][3];
	      
	cout << "podaj 9 liczb do macierzy 3x3:\n" << endl;

	//wczytywanie macierzy
	for (int i = 0; i < 3; i++) {
		for (int j = 0; j < 3; j++) {
			cout << "podaj element [" << i + 1 << "," << j + 1 << "]:" << endl;
			cin >> matrix[i][j];
		}
	}
	//wysietlanie macierzy
	cout << "\nMacierz 3x3:\n";
	for (int i = 0; i < 3; i++) {
		for (int j = 0; j < 3; j++) {
			cout << matrix[i][j] << "\t";
		}
		cout << endl;
	}
	return 0;
}
