zad 4 minimalna i maksymalna wartosc
#include<iostream>
#include<iomanip>
using namespace std;

int main() {
	int tab[10];
	cout << "podaj 10 liczb:\n" << endl;
	for (int i = 0; i < 10; i++) {
		cin >> tab[i];
	}
	int min = tab[0];
	int max = tab[0];

	for (int i = 0; i < 10; i++) {
		if (tab[i] < min)min = tab[i];
		if (tab[i] > max)max = tab[i];
	}
	cout << "minimalna wartosc: " << min << endl;
	cout << "maksymalna wartosc: " << max << endl;

	return 0;
}
