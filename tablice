zad 7 obliczanie parzystych i nie parzystych
#include<iostream>
#include<iomanip>
using namespace std;

int main() {
	int numery[10];
	int rozne[10], norma[10];
	int a = 0, b = 0;

	for (int i = 0; i < 10; i++) {
		cout << "podaj liczbe" << i + 1 << ": " << endl;
		cin >> numery[i];
	}
	for (int i = 0; i < 10; i++) {
		if (numery[i] % 2 == 0)
			rozne[a++] = numery[i];
		else
			norma[b++] = numery[i];
	}
	cout << "liczby parzyste: " << endl;
	for (int i = 0; i < a; i++)
		cout << rozne[i] << " ";
	cout << "\n liczby nieparzyste: " << endl;
	for (int i = 0; i < b; i++)
		cout << norma[i] << " " << endl;
}
