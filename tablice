zad 9 sprawdzanie podobieństwa
#include<iostream>
#include<iomanip>
using namespace std;

int main() {
	int tab1[5], tab2[5];
	bool identyczne = true;

	cout << "podaj piec elementow 1 tablicy.\n" << endl;
	for (int i = 0; i < 5; i++) {
		cin >> tab1[i];
	}
	cout << "podaj piec elementow 2 tablicy.\n" << endl;
	for (int i = 0; i < 5; i++) {
		cin >> tab2[i];
	}
	//sprawdzanie czy tablice sa identyczne
	for (int i = 0; i < 5; i++) {
		if (tab1[i] != tab2[i]) {
			identyczne = false;
			break;
		}
	}
	if (identyczne) {
		cout << "tablice sa identyczne.\n " << endl;
	}
	else
		cout << "tablice nie sa identyczne.\n " << endl;
	return 0;

}
