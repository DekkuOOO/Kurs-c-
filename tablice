#include<iostream>
#include<iomanip>
using namespace std;

int main() {
	double tab[8];
	double suma = 0;

	cout << "podaj 8 liczb:\n " << endl;
	for (int i = 1; i < 8; i++) {
		cin >> tab[i];
		suma += tab[i];
	}
